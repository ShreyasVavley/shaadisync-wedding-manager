# ========================================================
# ShaadiSync - Commercial Production Environment Config
# ========================================================

# Server Port and Environment
PORT=3000
NODE_ENV=production

# Base Public URL (e.g. https://rsvp.yourdomain.com or https://your-railway-app.up.railway.app)
APP_URL=http://localhost:3000

# Meta WhatsApp Cloud API Credentials (Graph API v21.0)
# Obtain these from: https://developers.facebook.com/apps/
META_WHATSAPP_TOKEN=your_meta_permanent_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WEBHOOK_VERIFY_TOKEN=shaadi_sync_verify_123

# Admin Security & Master Secret
ADMIN_MASTER_KEY=shaadi_sync_secret_key_2026
